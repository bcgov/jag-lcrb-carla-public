worker_processes auto;

error_log /var/log/nginx/error.log warn;
pid       /tmp/nginx.pid;

events {
    worker_connections 4096;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    server_tokens off;

    client_max_body_size 100M;

    proxy_connect_timeout 600;
    proxy_send_timeout    600;
    proxy_read_timeout    600;
    send_timeout          600;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;

    sendfile on;
    keepalive_timeout 65;
    underscores_in_headers on;

    # allow nginx to run as non-root
    client_body_temp_path /tmp/client_body;
    proxy_temp_path       /tmp/proxy;
    fastcgi_temp_path     /tmp/fastcgi;
    uwsgi_temp_path       /tmp/uwsgi;
    scgi_temp_path        /tmp/scgi;

    server {
        listen 8080;
        server_name localhost;

        add_header Content-Security-Policy "default-src * data: blob: filesystem: 'unsafe-inline' 'unsafe-eval'";
        add_header Strict-Transport-Security "max-age=86400; includeSubDomains";
        add_header X-Content-Type-Options "nosniff";
        add_header X-XSS-Protection 1;
        add_header X-Frame-Options DENY;

        # rewrite /lcrb prefix for dev/test builds
        rewrite ^/lcrb[^/]*/(.*) /$1 last;

        # proxy API and auth paths to the .NET backend service
        location /api {
            proxy_pass         http://cllc-public-app-gha:8080;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }

        location /login {
            proxy_pass         http://cllc-public-app-gha:8080;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }

        location /logout {
            proxy_pass         http://cllc-public-app-gha:8080;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }

        # BC Services Card sign-in (BCServiceController, [Route("bcservice")]).
        # The SEP login page and the worker/cannabis screening pages navigate
        # here directly, e.g. sep/login.component.ts: `bcservice?source=...`.
        # Without this the request falls through to `location /`, nginx returns
        # index.html, and the Angular router has no /bcservice route — so the
        # user lands on the app's own 404 page and is never authenticated.
        location /bcservice {
            proxy_pass         http://cllc-public-app-gha:8080;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }

        location /hc {
            proxy_pass http://cllc-public-app-gha:8080;
        }

        # The embedded due diligence assistant (a separate single-page app).
        #
        # Proxied rather than built into this image so it can be released independently -- and,
        # more importantly, so it shares this origin. Same-origin is the whole point: the chat
        # calls /api/agent-framework/... which is proxied to the .NET app above, and only a
        # same-origin request carries the portal session cookie. The .NET app exchanges that
        # session for a short-lived platform token (AgenticPlatformProxyMiddleware). Served from
        # its own hostname instead, the cookie would not be sent and every call would come back
        # unauthenticated -- and browsers now block third-party cookies in an iframe regardless.
        #
        # The host below is the embedded build's Front Door endpoint, a second deployment of the
        # chat UI in the same AKS cluster as the staff one. It is a distinct image tag (:embedded)
        # and a distinct ingress host, because the difference between the two builds is baked in at
        # build time: this one carries no Entra client id, uses /chat/ as its base path so asset
        # URLs come back through this location, keeps the transcript in the browser, and names the
        # portal's origins in VITE_ALLOWED_ORIGINS, which become its Content-Security-Policy
        # frame-ancestors. Pointing this at the staff endpoint would try to sign a licensee in with
        # Entra, an account they do not have.
        location /chat/ {
            proxy_pass         https://lcrb-chatembed-test-dcbvdtbve5ade7gj.a03.azurefd.net/;
            proxy_set_header   Host              lcrb-chatembed-test-dcbvdtbve5ade7gj.a03.azurefd.net;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;

            # The upstream sets its own X-Frame-Options. Two of them in one response is treated as
            # a conflict by browsers and the frame is refused, so drop the upstream copy and set
            # ours below.
            proxy_hide_header  X-Frame-Options;

            # nginx discards every inherited add_header as soon as a block declares one of its own,
            # so the server-level set is repeated here rather than being lost. X-Frame-Options is
            # SAMEORIGIN rather than DENY because this page is framed by the portal itself, and
            # DENY blocks same-origin framing too.
            add_header Content-Security-Policy "default-src * data: blob: filesystem: 'unsafe-inline' 'unsafe-eval'";
            add_header Strict-Transport-Security "max-age=86400; includeSubDomains";
            add_header X-Content-Type-Options "nosniff";
            add_header X-XSS-Protection 1;
            add_header X-Frame-Options SAMEORIGIN;
        }

        location / {
            root  /usr/share/nginx/html;
            index index.html index.htm;
            try_files $uri /index.html;
            gzip on;
            gzip_min_length 1000;
            gzip_types *;
        }

        location /nginx_status {
            stub_status on;
            allow all;
            access_log off;
        }

        error_page 500 502 503 504 /50x.html;
        location = /50x.html {
            root /usr/share/nginx/html;
        }
    }
}
