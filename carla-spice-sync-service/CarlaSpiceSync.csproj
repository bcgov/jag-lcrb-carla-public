  </ItemGroup>
  <ItemGroup>
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="models\Application.cs" />
    <Compile Remove="WorkerResultParser.cs" />
    <Compile Remove="WorkerUpdater.cs" />
  </ItemGroup>
</Project>
