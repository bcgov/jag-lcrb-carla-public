{
  "name": "lcrb-public-portal-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "ng": "ng",
    "build": "ng build",
    "dev": "ng serve --host 0.0.0.0 --port 4220",
    "test": "ng test --watch=false",
    "test:tools": "vitest run --config vitest.tools.config.ts",
    "lint": "eslint .",
    "boundaries": "vitest run --config vitest.tools.config.ts tests/boundaries.test.ts",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "@spartan-ng/brain": "1.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide": "0.564.0",
    "rxjs": "7.8.2",
    "tailwind-merge": "3.4.0",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.2.0",
    "@types/node": "24.19.2",
    "angular-eslint": "22.8.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.4.5",
    "jsdom": "30.1.3",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.2.0",
    "tsx": "4.23.15",
    "tw-animate-css": "1.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.0"
  }
}
