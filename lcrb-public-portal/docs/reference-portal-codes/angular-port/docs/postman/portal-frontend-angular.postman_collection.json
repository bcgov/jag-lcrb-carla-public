              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "upload"
              ]
            }
          }
        },
        {
          "name": "upload",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (pm.response.code === 200) pm.test('blob metadata', () => pm.expect(j).to.include.keys('url', 'pathname', 'filename', 'contentType', 'size'));",
                  "else pm.test('500 Upload failed', () => { pm.response.to.have.status(500); pm.expect(j).to.eql({ error: 'Upload failed' }); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "sample-upload.txt"
                },
                {
                  "key": "subjectId",
                  "value": "postman",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "upload"
              ]
            },
            "description": "Needs BLOB_READ_WRITE_TOKEN for a 200; without it the route answers 500 Upload failed."
          }
        },
        {
          "name": "file (missing pathname)",
          "event": [
