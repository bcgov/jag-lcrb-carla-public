          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/files",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files"
              ]
            },
            "description": "Needs BLOB_READ_WRITE_TOKEN for a 200; otherwise 500."
          }
