            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('file, not found or failure', () => pm.expect([200, 304, 404, 500]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) pm.test('private no-cache', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('private, no-cache'));"
