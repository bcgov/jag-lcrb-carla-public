{
  "info": {
    "name": "portal-frontend-angular",
    "description": "Access gate and the 21 API routes of the Angular app. Set baseUrl to the port (gate off) and gatedUrl to a server with ACCESS_CODE set. accessCode defaults to the dummy GATE_TEST_CODE. Without AI_GATEWAY_API_KEY or BLOB_READ_WRITE_TOKEN the AI and Blob routes return their friendly errors, which the tests accept. Run it with make v2-postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8090"
    },
    {
      "key": "gatedUrl",
      "value": "http://angular-gated:8080"
    },
    {
      "key": "accessCode",
      "value": "parity-gate-code"
    },
    {
      "key": "gateCookie",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Gate",
      "description": "Port of proxy.ts and app/gate/actions.ts, against gatedUrl.",
      "item": [
        {
          "name": "API without cookie is 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('JSON error', () => pm.expect(pm.response.json()).to.eql({ error: 'Access code required.' }));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatedUrl}}/api/entity-directory",
              "host": [
                "{{gatedUrl}}"
              ],
              "path": [
                "api",
                "entity-directory"
              ]
            }
          }
        },
        {
          "name": "Page without cookie redirects to the gate",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('307', () => pm.response.to.have.status(307));",
                  "pm.test('to /gate with next', () => pm.expect(pm.response.headers.get('Location')).to.match(/\\/gate\\?next=%2Fdashboard$/));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatedUrl}}/dashboard",
              "host": [
                "{{gatedUrl}}"
              ],
              "path": [
                "dashboard"
              ]
            }
          }
        },
        {
          "name": "Unlock with a wrong code",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('303 back to the gate with the error', () => { pm.response.to.have.status(303); pm.expect(pm.response.headers.get('Location')).to.eql('/gate?error=1&next=%2Flicences'); });",
                  "pm.test('no cookie', () => pm.expect(pm.response.headers.has('Set-Cookie')).to.be.false);"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "code",
                  "value": "wrong-code"
                },
                {
                  "key": "next",
                  "value": "/licences"
                }
              ]
            },
            "url": {
              "raw": "{{gatedUrl}}/gate",
              "host": [
                "{{gatedUrl}}"
              ],
              "path": [
                "gate"
              ]
            }
          }
        },
        {
          "name": "Unlock with the access code",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('303 to next', () => { pm.response.to.have.status(303); pm.expect(pm.response.headers.get('Location')).to.eql('/licences'); });",
                  "const c = pm.response.headers.get('Set-Cookie') || '';",
                  "pm.test('5 h HttpOnly lax cookie', () => { pm.expect(c).to.match(/^lcrb_access=[0-9a-f]{64};/); pm.expect(c).to.include('Max-Age=18000'); pm.expect(c).to.include('HttpOnly'); pm.expect(c).to.include('SameSite=lax'); });",
                  "pm.collectionVariables.set('gateCookie', c.split(';')[0]);"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "code",
                  "value": "{{accessCode}}"
                },
                {
                  "key": "next",
                  "value": "/licences"
                }
              ]
            },
            "url": {
              "raw": "{{gatedUrl}}/gate",
              "host": [
                "{{gatedUrl}}"
              ],
              "path": [
                "gate"
              ]
            }
          }
        },
        {
          "name": "API with the cookie",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "{{gateCookie}}"
              }
            ],
            "url": {
              "raw": "{{gatedUrl}}/api/entity-directory",
              "host": [
                "{{gatedUrl}}"
              ],
              "path": [
                "api",
                "entity-directory"
              ]
            }
          }
        }
      ]
    },
