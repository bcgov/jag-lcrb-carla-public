                "file"
              ],
              "query": [
                {
                  "key": "pathname",
                  "value": "documents/postman/sample-upload.txt"
                }
              ]
            },
            "description": "Needs BLOB_READ_WRITE_TOKEN and an uploaded file; otherwise 404 or 500."
          }
        },
        {
          "name": "files",
