{
  "name": "portal-frontend-angular-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "ng": "ng",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "dev:web": "ng serve --host 0.0.0.0 --port 4210 --proxy-config proxy.conf.json",
    "dev:server": "tsx watch --tsconfig tsconfig.server.json server/main.ts",
    "start": "tsx --tsconfig tsconfig.server.json server/main.ts",
    "test": "ng test --watch=false",
    "test:server": "vitest run --config vitest.server.config.ts",
    "test:secrets": "vitest run --config vitest.server.config.ts tests/bundle-secrets.test.ts",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "e2e": "playwright test",
    "icons": "node tools/gen-icons.mjs",
    "generate:client": "node tools/generate-client.mjs"
  },
  "dependencies": {
    "@ai-sdk/angular": "2.0.209",
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "@spartan-ng/brain": "1.9.0",
    "@vercel/analytics": "1.6.1",
    "@vercel/blob": "2.4.0",
    "ai": "6.0.208",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3-drag": "3.0.1",
    "d3-selection": "3.0.1",
    "d3-zoom": "3.0.1",
    "date-fns": "4.1.0",
    "echarts": "6.1.0",
    "express": "5.3.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "leaflet": "1.9.4",
    "lucide": "0.564.0",
    "ngx-echarts": "22.0.0",
    "ngx-vflow": "2.7.0",
    "rxjs": "7.8.2",
    "tailwind-merge": "3.4.0",
    "tslib": "2.9.1",
    "tsx": "4.23.15",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@playwright/test": "1.65.0",
    "@spartan-ng/cli": "1.9.0",
    "@tailwindcss/postcss": "4.2.0",
    "@types/d3-drag": "3.0.7",
    "@types/d3-selection": "3.0.12",
    "@types/d3-zoom": "3.0.9",
    "@types/express": "5.0.6",
    "@types/leaflet": "1.9.21",
    "@types/node": "24.19.2",
    "jsdom": "30.1.3",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.2.0",
    "tw-animate-css": "1.3.3",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
