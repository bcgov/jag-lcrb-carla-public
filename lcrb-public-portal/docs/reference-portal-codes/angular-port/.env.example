# portal-frontend-angular environment variables.
# Copy to .env and fill in what you need. Never commit .env.
# Only the Express server (server/) reads these; the Angular bundle never does.

# --- Server -----------------------------------------------------------------
# Port the Express server listens on (inside the container too).
PORT=8080
# development or production. Production sets the gate cookie Secure flag and enables analytics.
NODE_ENV=development

# --- Access gate (port of the prototype's proxy.ts) ------------------------------
# Shared passcode. Leave empty to disable the gate.
ACCESS_CODE=

# --- AI (read implicitly by the `ai` SDK) -----------------------------------------
# Vercel AI Gateway key. Without it, AI routes return friendly errors.
AI_GATEWAY_API_KEY=

# --- File storage (read implicitly by @vercel/blob) -------------------------------
# Without it, upload, file and files routes fail as in the prototype.
BLOB_READ_WRITE_TOKEN=

# --- Optional external registries (simulated when unset) -------------------------
BC_REGISTRIES_API_URL=
BC_REGISTRIES_API_KEY=
RESPONSIBLE_SERVICE_API_URL=
RESPONSIBLE_SERVICE_API_KEY=

# --- Docker compose host ports ------------------------------------------------------
# Host port for the Angular container (maps to PORT inside it).
ANGULAR_PORT=8080
# Host port for the untouched Next.js prototype used as the visual reference.
REFERENCE_PORT=3000

# --- Playwright parity suites -------------------------------------------------------
# Defaults point at the compose services when run in the Playwright container.
ANGULAR_URL=http://angular:8080
REFERENCE_URL=http://nextjs-reference:3000


# --- Gated reference (access gate flow and screenshots) ----------------------------
# Dummy access code for the gated test instances. A test value, not a secret.
GATE_TEST_CODE=parity-gate-code
# Host port for the gated Next.js reference.
REFERENCE_GATED_PORT=3001
# Gated app URLs inside the Playwright container (the Angular one is used from P5).
REFERENCE_GATED_URL=http://nextjs-reference-gated:3000
ANGULAR_GATED_URL=http://angular-gated:8080

# Host port for the gated Angular container (angular-gated, ACCESS_CODE = GATE_TEST_CODE)
ANGULAR_GATED_PORT=8081

V2_ANGULAR_PORT=8090
V2_ANGULAR_GATED_PORT=8091
V2_REFERENCE_PORT=3010
V2_REFERENCE_GATED_PORT=3011