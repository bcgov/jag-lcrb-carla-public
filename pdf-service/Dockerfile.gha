FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
WORKDIR /app
EXPOSE 8080
ENV ASPNETCORE_URLS=http://*:8080

# wkhtmltopdf system dependencies — must run as root before switching back to app user
USER root
RUN apt-get update && apt-get install -y \
    fontconfig \
    libfontconfig1 \
    libfreetype6 \
    libjpeg62-turbo \
    libpng16-16 \
    libssl3 \
    bzip2 \
    libstdc++6 \
    libx11-6 \
    libxext6 \
    libxrender1 \
    ca-certificates \
    wget \
    && rm -rf /var/lib/apt/lists/*

# libwkhtmltox.so was built against OpenSSL 1.1, which bookworm's base image
# no longer ships (only libssl3/OpenSSL 3.x) — pull the bullseye (deb11) security
# build of libssl1.1 directly since it's no longer available via apt on bookworm.
RUN wget -q -O /tmp/libssl1.1.deb http://deb.debian.org/debian-security/pool/updates/main/o/openssl/libssl1.1_1.1.1w-0+deb11u8_amd64.deb \
    && dpkg -i /tmp/libssl1.1.deb \
    && rm /tmp/libssl1.1.deb \
    && apt-get purge -y wget \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

USER app

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY ["pdf-service/pdf-service.csproj", "pdf-service/"]
RUN dotnet restore "pdf-service/pdf-service.csproj"

COPY pdf-service/ pdf-service/
WORKDIR "/src/pdf-service"
RUN dotnet build "pdf-service.csproj" -c Release -o /app/build

FROM build AS publish
RUN dotnet publish "pdf-service.csproj" -c Release -o /app/publish

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "pdf-service.dll"]
